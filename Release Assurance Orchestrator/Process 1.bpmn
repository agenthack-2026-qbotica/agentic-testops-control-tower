          <uipath:output name="escalationPayload" type="jsonSchema" source="=escalationPayload" var="escalationPayload" />
          <uipath:output name="humanReviewOutcome" type="jsonSchema" source="=humanReviewOutcome" var="humanReviewOutcome" />
        </uipath:activity>
