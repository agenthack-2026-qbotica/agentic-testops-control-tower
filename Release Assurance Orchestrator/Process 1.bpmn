        </uipath:tags>
        <uipath:activity version="v1">
          <uipath:type value="Orchestrator.StartAgentJob" version="v2" />
          <uipath:context>
            <uipath:input name="name" type="string" value="=bindings.bGFmuZnGJ" />
            <uipath:input name="folderPath" type="string" value="=bindings.bBE2FBADK" />
            <uipath:input name="_label" type="string" value="HITL PR Review Agent" />
            <uipath:inputSchema type="jsonSchema"><![CDATA[{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"repositoryName":{"type":"string"},"owner":{"type":"string"},"pullRequestNumber":{"type":"integer"},"title":{"type":"string"},"url":{"type":"string"}},"required":["repositoryName","owner","pullRequestNumber","title","url"]}]]></uipath:inputSchema>
